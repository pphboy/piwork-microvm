ARG BASE=debian@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587
FROM docker@sha256:2a232a42256f70d78e3cc5d2b5d6b3276710a0de0596c145f627ecfae90282ac AS certificates
FROM ${BASE}
COPY --from=certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG SNAPSHOT=20261018T000000Z
RUN rm -f /etc/apt/sources.list.d/* && printf 'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/%s/ bookworm main\n' "$SNAPSHOT" > /etc/apt/sources.list \
 && apt-get update && apt-get install -y --no-install-recommends build-essential bc bison flex libelf-dev libssl-dev cpio xz-utils python3 git ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /project
