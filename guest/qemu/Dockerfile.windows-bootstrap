# Developer-only toolchain refresh; ordinary builds consume the RPM lock.
FROM registry.fedoraproject.org/fedora@sha256:291ed4c06d5435a92d05ad622c9717afde6911e96d335e02919336eed0c8ae03
RUN dnf -y --disablerepo=fedora-cisco-openh264 install \
      gcc make glib2-devel python3 python3-pip ninja-build meson git curl tar xz \
      mingw64-gcc mingw64-gcc-c++ mingw64-pkg-config mingw64-glib2 mingw64-zlib diffutils \
 && rpm -qa | sort > /qemu-build-packages.txt
WORKDIR /project
